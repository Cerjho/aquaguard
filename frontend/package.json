{
  "name": "aquaguard-dashboard",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "@lottiefiles/dotlottie-react": "^0.19.0",
    "@testing-library/dom": "^10.4.1",
    "axios": "^1.15.0",
    "framer-motion": "^11.18.2",
    "gsap": "^3.13.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-is": "18.3.1",
    "react-router-dom": "^6.30.3",
    "recharts": "^3.8.1",
    "socket.io-client": "4.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "6.5.0",
    "@testing-library/react": "16.0.0",
    "@testing-library/user-event": "14.5.2",
    "autoprefixer": "10.4.20",
    "axios-mock-adapter": "^2.1.0",
    "playwright": "^1.59.1",
    "postcss": "8.5.15",
    "react-scripts": "5.0.1",
    "tailwindcss": "3.4.13",
    "typescript": "4.9.5"
    ,
    "cross-env": "^7.0.3"
  },
  "overrides": {
    "nth-check": "2.1.1",
    "postcss": "8.5.15",
    "serialize-javascript": "^7.0.5",
    "underscore": "1.13.8",
    "@tootallnate/once": "3.0.1",
    "uuid": "^11.1.1",
    "ws": "^8.20.1",
    "qs": "^6.15.2"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "test:unit": "react-scripts test --watchAll=false",
    "test:e2e": "cross-env NODE_OPTIONS=--max-old-space-size=4096 npx playwright test",
    "test:e2e:smoke": "cross-env NODE_OPTIONS=--max-old-space-size=4096 npx playwright test --grep @smoke",
    "test:e2e:ui": "cross-env NODE_OPTIONS=--max-old-space-size=4096 npx playwright test --ui",
    "test:e2e:headed": "cross-env NODE_OPTIONS=--max-old-space-size=4096 npx playwright test --headed",
    "test:e2e:debug": "cross-env NODE_OPTIONS=--max-old-space-size=4096 npx playwright test --debug",
    "test:all": "npm run test:unit && npm run test:e2e:smoke",
    "playwright:install": "npx playwright install",
    "playwright:report": "npx playwright show-report",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "jest": {
    "transformIgnorePatterns": [
      "/node_modules/(?!axios/)"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.js",
      "**/?(*.)+(spec|test).[jt]s?(x)"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
