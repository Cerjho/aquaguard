# ── Compose database defaults ─────────────────────────────────────────────────
MYSQL_DATABASE=aquaguard
MYSQL_USER=aquaguard
MYSQL_PASSWORD=aquaguardpass
MYSQL_ROOT_PASSWORD=aquaguardrootpass

# Optional explicit backend database URL override.
# DATABASE_URL=mysql+pymysql://aquaguard:aquaguardpass@mysql:3306/aquaguard

# ── Backend production secrets (required for deployment) ──────────────────────
SECRET_KEY=change-me-to-a-random-secret
JWT_SECRET_KEY=change-me-to-another-random-secret
AQUAGUARD_API_KEY=change-me-internal-api-key-min-32-chars
SEED_ADMIN_PASSWORD=change-me-admin-password
SEED_GUARD_PASSWORD=change-me-guard-password

# ── Backend runtime tuning ─────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
RATELIMIT_STORAGE_URI=redis://redis:6379/1
CORS_ALLOWED_ORIGINS=https://aquaguard.local
APP_ENV=production
FLASK_ENV=production

# ── MQTT / TURN ────────────────────────────────────────────────────────────────
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883
TURN_REALM=aquaguard.local
TURN_USERNAME=aquaguard
TURN_PASSWORD=aquaguardpass
# Set to the host machine's LAN IP for cross-device WebRTC relay.
TURN_EXTERNAL_IP=127.0.0.1
TURN_RELAY_MIN_PORT=49152
TURN_RELAY_MAX_PORT=49200
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302
WEBRTC_TURN_URL=turn:aquaguard.local:3478?transport=udp
WEBRTC_TURN_USERNAME=aquaguard
WEBRTC_TURN_CREDENTIAL=aquaguardpass

# ── Frontend build-time variables (used by Docker build args) ─────────────────
# TURN credentials are NOT included here — they are fetched at runtime
# via GET /api/v1/webrtc/ice-config to avoid leaking into the JS bundle.
REACT_APP_API_URL=http://localhost:5000
REACT_APP_WS_URL=http://localhost:5000
REACT_APP_WEBRTC_STUN_URLS=stun:stun.l.google.com:19302
REACT_APP_WEBRTC_ICE_TRANSPORT_POLICY=all
REACT_APP_WEBRTC_FORCE_RELAY=false
REACT_APP_WEBRTC_ENABLE=true

# Optional frontend crash reporting (low-priority hardening)
REACT_APP_SENTRY_DSN=

# ── Backend observability & error reporting ────────────────────────────────────
# Log format: "text" (default) or "json" for structured log aggregators
AQUAGUARD_LOG_FORMAT=text
# Sentry DSN for backend error tracking (optional)
SENTRY_DSN=

# ── Backend operational tuning ─────────────────────────────────────────────────
# Skip db.create_all() and user seeding on startup (set to 1 for migration-only boots)
AQUAGUARD_SKIP_STARTUP_BOOTSTRAP=0
# Force-reset default user passwords on every startup (set to 1 to enable)
RESET_DEFAULT_PASSWORDS_ON_STARTUP=0
# Global Flask-Limiter defaults (comma-separated)
FLASK_DEFAULT_RATE_LIMITS=2000 per day,300 per hour
# Stream token lifetime in seconds
STREAM_TOKEN_TTL_SECONDS=30

# ── ESP32 / device heartbeat ──────────────────────────────────────────────────
# Enable/disable the MQTT bridge for ESP32 heartbeats
ESP32_MQTT_BRIDGE_ENABLED=true
# Seconds before an ESP32 heartbeat is considered stale
ESP32_HEARTBEAT_STALE_THRESHOLD_SECONDS=30
# Seconds before a live camera snapshot is considered stale
LIVE_SNAPSHOT_STALE_THRESHOLD_SECONDS=10

# ── Redis / token blocklist tuning ─────────────────────────────────────────────
# Seconds to wait for Redis connection before fallback
REDIS_CONNECT_TIMEOUT_SECONDS=0.25
# Fail-closed token blocklist in production (reject tokens when Redis is down)
TOKEN_BLOCKLIST_FAIL_CLOSED=true
