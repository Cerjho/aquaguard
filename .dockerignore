# ===========================================================
# Root .dockerignore — used by backend (context: repo root)
# ===========================================================

# VCS, editor, and CI metadata.
.git/
.github/
.vscode/
.idea/
.playwright-mcp/

# Local environments and Python artifacts.
aquaguard_env/
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
**/*.egg-info/
.pytest_cache/
.coverage
**/.pytest_cache/

# Frontend artifacts (not needed for backend image).
frontend/node_modules/
frontend/build/
frontend/e2e/

# Runtime/generated data — must never be baked into an image.
backend/instance/
backend/snapshots/
*.db
*.sqlite3
*.log

# Large detection model weights — mounted at runtime, not baked in.
detection_engine/models/

# Secrets — NEVER ship .env files into a Docker image.
.env
.env.*
backend/.env
backend/.env.*

# Documentation, scripts, and agent orchestration — not runtime code.
docs/
scripts/
agents/
*.md
LICENSE

# Compose and infra files — not needed inside containers.
docker-compose*.yml
infra/
mqtt/

# Misc generated files.
*.log
.DS_Store
Thumbs.db