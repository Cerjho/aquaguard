# AquaGuard Backend — Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

SECRET_KEY=aquaguard-secret-key-change-in-production
JWT_SECRET_KEY=aquaguard-jwt-secret-change-in-production
DATABASE_URL=sqlite:///aquaguard.db
FLASK_ENV=development
FLASK_DEBUG=1
FLASK_APP=wsgi.py
