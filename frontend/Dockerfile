FROM node:20-alpine AS build
WORKDIR /app

ARG REACT_APP_API_URL=http://localhost:5000
ARG REACT_APP_WS_URL=http://localhost:5000
ARG REACT_APP_WEBRTC_STUN_URLS=stun:stun.l.google.com:19302
ARG REACT_APP_WEBRTC_TURN_URL=turn:localhost:3478?transport=udp
ARG REACT_APP_WEBRTC_TURN_USERNAME=aquaguard
ARG REACT_APP_WEBRTC_TURN_CREDENTIAL=aquaguardpass
ARG REACT_APP_WEBRTC_ICE_TRANSPORT_POLICY=all
ARG REACT_APP_WEBRTC_FORCE_RELAY=false
ARG REACT_APP_WEBRTC_ENABLE=true

ENV REACT_APP_API_URL=${REACT_APP_API_URL}
ENV REACT_APP_WS_URL=${REACT_APP_WS_URL}
ENV REACT_APP_WEBRTC_STUN_URLS=${REACT_APP_WEBRTC_STUN_URLS}
ENV REACT_APP_WEBRTC_TURN_URL=${REACT_APP_WEBRTC_TURN_URL}
ENV REACT_APP_WEBRTC_TURN_USERNAME=${REACT_APP_WEBRTC_TURN_USERNAME}
ENV REACT_APP_WEBRTC_TURN_CREDENTIAL=${REACT_APP_WEBRTC_TURN_CREDENTIAL}
ENV REACT_APP_WEBRTC_ICE_TRANSPORT_POLICY=${REACT_APP_WEBRTC_ICE_TRANSPORT_POLICY}
ENV REACT_APP_WEBRTC_FORCE_RELAY=${REACT_APP_WEBRTC_FORCE_RELAY}
ENV REACT_APP_WEBRTC_ENABLE=${REACT_APP_WEBRTC_ENABLE}

COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM nginx:alpine
COPY --from=build /app/build /usr/share/nginx/html
EXPOSE 80
