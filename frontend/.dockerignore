# ===========================================================
# Frontend .dockerignore — context: frontend/
# ===========================================================

# Node and build artifacts — installed fresh during docker build.
node_modules/
build/

# E2E test outputs, caches, and reports.
e2e/test-results/
e2e/playwright-report/
e2e/reports/

# Local metadata and editor files.
.git/
.vscode/
.idea/
.pytest_cache/

# Secrets — must NEVER enter the build context.
.env
.env.*

# Logs and debug output.
npm-debug.log*
*.log

# Documentation and non-runtime files.
*.md
Dockerfile
.dockerignore
coverage/