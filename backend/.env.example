SECRET_KEY=aquaguard-secret-key-change-in-production
JWT_SECRET_KEY=aquaguard-jwt-secret-change-in-production
SECRET_KEY_FILE=
JWT_SECRET_KEY_FILE=
APP_ENV=development
DATABASE_URL=sqlite:///aquaguard.db
FLASK_ENV=development
FLASK_DEBUG=1
FLASK_APP=wsgi.py
PORT=5000
DB_READY_RETRIES=30
DB_READY_DELAY_SECONDS=2
DB_MIGRATION_RETRIES=5
DB_MIGRATION_DELAY_SECONDS=3
SEED_ON_STARTUP=true
GUNICORN_WORKERS=1
CORS_ALLOWED_ORIGINS=http://localhost:3000
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=Lax
REDIS_URL=redis://localhost:6379/0
REDIS_CONNECT_TIMEOUT_SECONDS=0.25
REDIS_SOCKET_TIMEOUT_SECONDS=0.25
REDIS_FAILURE_COOLDOWN_SECONDS=1
# In production, token blocklist defaults to fail-closed unless overridden.
TOKEN_BLOCKLIST_FAIL_CLOSED=
RATELIMIT_ENABLED=true
RATELIMIT_STORAGE_URI=memory://
AQUAGUARD_API_KEY=change-me-internal-api-key-min-32-chars
AQUAGUARD_API_KEY_FILE=
ESP32_HEARTBEAT_STALE_THRESHOLD_SECONDS=30
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
SEED_ADMIN_PASSWORD=change-me-admin-password
SEED_GUARD_PASSWORD=change-me-lifeguard-password

# Optional WebRTC tuning
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302
WEBRTC_TURN_URL=turn:your-turn-host:3478?transport=udp
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=
WEBRTC_ICE_TRANSPORT_POLICY=all
WEBRTC_FORCE_RELAY=false
WEBRTC_FUTURE_TIMEOUT_SECONDS=20
WEBRTC_ICE_GATHERING_TIMEOUT_SECONDS=3
