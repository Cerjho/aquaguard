:443, :80 {
    tls internal

    @api path /api/* /socket.io/* /snapshots/live/*
    reverse_proxy @api backend:5000 {
        header_up Host {host}
        transport http {
            dial_timeout 5s
        }
    }

    reverse_proxy frontend:80 {
        header_up Host {host}
        transport http {
            dial_timeout 5s
        }
    }
}
