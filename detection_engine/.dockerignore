# ===========================================================
# Detection Engine .dockerignore — context: detection_engine/
# ===========================================================

# Large model weights — mounted as a volume at runtime, never baked in.
models/*.pt
models/*.onnx

# Python cache and build artifacts.
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
build/
dist/

# Local virtual environments and editor metadata.
.venv/
venv/
.vscode/
.idea/

# Tests and reports — not needed in production image.
tests/
.pytest_cache/

# Secrets — must NEVER enter the build context.
.env
.env.*

# Logs, docs, and non-runtime files.
*.log
*.md
Dockerfile
.dockerignore
setup.py
benchmark.py